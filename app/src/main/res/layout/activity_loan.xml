<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F5"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← Back"
            android:textColor="#2D7454"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@android:color/transparent"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/issueCapitalTitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Issue Capital"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#6D5A7A"
                android:layout_marginBottom="26dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT BORROWER"
                android:textColor="#A7A0AD"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.20" />

            <Spinner
                android:id="@+id/borrowerSpinner"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:padding="14dp" />

            <TextView
                android:id="@+id/eligibilityText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eligible Loan: ₹0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2D7454"
                android:background="#FFFDF5"
                android:padding="14dp"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRINCIPAL (₹)"
                        android:textColor="#A7A0AD"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />

                    <EditText
                        android:id="@+id/principalEt"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:inputType="numberDecimal"
                        android:background="@drawable/bg_input"
                        android:padding="14dp"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INTEREST RATE %"
                        android:textColor="#A7A0AD"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />

                    <EditText
                        android:id="@+id/rateEt"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:inputType="numberDecimal"
                        android:background="@drawable/bg_input"
                        android:padding="14dp"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DURATION (MONTHS)"
                android:textColor="#A7A0AD"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginTop="22dp" />

            <EditText
                android:id="@+id/monthsEt"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="number"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Interest and repayable amount will appear here"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#6D5A7A"
                android:background="#FFFDF5"
                android:padding="20dp"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/applyLoanBtn"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Approve &amp; Disburse"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/bg_green_button"
                android:layout_marginTop="24dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>