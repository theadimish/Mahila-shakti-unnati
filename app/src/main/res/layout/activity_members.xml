<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F7F5"
    android:padding="22dp">

    <Button
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="← Back"
        android:textColor="#2D7454"
        android:textStyle="bold"
        android:backgroundTint="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/membersTitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Members"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/dark_purple" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="18dp">

        <EditText
            android:id="@+id/memberSearchEt"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:hint="Search member"
            android:textSize="14sp"
            android:singleLine="true"
            android:padding="12dp"
            android:textColor="@color/dark_purple"
            android:textColorHint="@color/hint_readable"
            android:background="#FFFFFF" />

        <!-- Add Member Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/addMemberSmallBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="+"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_green_bg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Member"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/dark_purple"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap member for contribution history. Long press to delete."
        android:textSize="14sp"
        android:textColor="@color/dark_purple"
        android:layout_marginTop="10dp" />

    <ListView
        android:id="@+id/membersListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:divider="#EEEEEE"
        android:dividerHeight="10dp"
        android:background="#F6F7F5" />

</LinearLayout>