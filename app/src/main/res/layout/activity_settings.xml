<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F5"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="← Back"
            android:textColor="#2D7454"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/settingsTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/dark_purple"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="34dp" />

        <TextView
            android:id="@+id/appSettingsTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APP SETTINGS"
            android:textColor="#B2A8B8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.22"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="22dp">

            <LinearLayout
                android:id="@+id/profileSettingsRow"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/profileIconIv"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:src="@drawable/outline_group_24"
                    app:tint="#2D7454" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profile Settings"
                        android:textColor="@color/dark_purple"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/groupNameSubTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Group Information"
                        android:textColor="#9BA0A8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="34sp"
                    android:textColor="#D6D6D6" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/languageRow"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/languageIconIv"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:src="@drawable/baseline_description_24"
                    app:tint="#2D7454" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Language"
                        android:textColor="@color/dark_purple"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/languageSubTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English (India)"
                        android:textColor="#9BA0A8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="34sp"
                    android:textColor="#D6D6D6" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/themeRow"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/themeIconIv"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:src="@drawable/settings"
                    app:tint="#2D7454" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Theme Selector"
                        android:textColor="@color/dark_purple"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/themeSubTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Purple"
                        android:textColor="#9BA0A8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="34sp"
                    android:textColor="#D6D6D6" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/logoutRow"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="22dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="30dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#FFE3E3"
                android:padding="12dp"
                android:src="@drawable/logout"
                app:tint="#FF3B30" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Logout"
                android:textColor="#D60000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="34sp"
                android:textColor="#FFC0C0" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>