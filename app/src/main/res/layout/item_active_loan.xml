<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="18dp"
    android:layout_marginBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/loanInitialTv"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="R"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#6D5A7A"
            android:background="@drawable/bg_input" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/loanNameTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rani Devi"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#6D5A7A" />

            <TextView
                android:id="@+id/loanDateTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE SINCE 2026-05-06"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#A7A0AD" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↗"
            android:textSize="32sp"
            android:textColor="#F0F0F0"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRINCIPAL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#A7A0AD" />

            <TextView
                android:id="@+id/loanPrincipalTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹5000"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#6D5A7A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTEREST"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#A7A0AD" />

            <TextView
                android:id="@+id/loanInterestTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹1200"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#2D7454" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TYPE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#A7A0AD" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STANDARD"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#D4AF37" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>