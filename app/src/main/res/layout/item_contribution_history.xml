<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/ledger_card_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyAmountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹100"
            android:textColor="#6D5A7A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/historyDateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date: 2026-05-05"
            android:textColor="#8C8C9A"
            android:textSize="14sp"
            android:layout_marginTop="5dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/historyStatusText"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="PAID"
        android:textColor="#148C4A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="#DDFBE8" />

</LinearLayout>